install.packages("class")
library(class)
set.seed(123)
train_index <- sample(1:nrow(df), 0.7 * nrow(df))
train <- df[train_index, ]
test  <- df[-train_index, ]
train_x <- train[, !(names(train) %in% "Depression")]
test_x  <- test[, !(names(test) %in% "Depression")]
train_x <- train_x[, sapply(train_x, is.numeric)]
test_x  <- test_x[, sapply(test_x, is.numeric)]
train_y <- train$Depression
test_y  <- test$Depression
train_x <- scale(train_x)
test_x <- scale(
test_x,
center = attr(train_x, "scaled:center"),
scale  = attr(train_x, "scaled:scale")
)
pred_knn <- knn(
train = train_x,
test = test_x,
cl = train_y,
k = 5
)
table(Predicted = pred_knn, Actual = test_y)
accuracy_knn <- mean(pred_knn == test_y)
cat("KNN Accuracy:", accuracy_knn)
